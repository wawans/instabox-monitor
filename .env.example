# ==============================================================================
# InstaBox Monitor — Environment Variables Example
# Salin file ini menjadi `.env` (file `.env` otomatis di-ignore oleh Git)
# ==============================================================================

# Docker image untuk deployment GHCR
IMAGE=ghcr.io/wawans/instabox-monitor:latest

# Port HTTP server dashboard
PORT=8080

# Mode environment aplikasi:
# - production (default): log hanya ke stdout (level INFO), tidak menulis file ke logs/
# - DEBUG: log level DEBUG ke stdout + logs/log-yyyy-mm-dd.log (auto-prune 7 hari)
APP_ENV=production

# Timezone untuk nama file log harian (didukung penuh di distroless via embedded tzdata)
TZ=UTC

# Direktori data persisten SQLite & fallback .master.key
DATA_DIR=/data

# Direktori log harian (hanya aktif saat APP_ENV=DEBUG)
LOG_DIR=/app/logs

# Kunci master enkripsi AES-256-GCM untuk API key InstaBox di SQLite
# WAJIB diset pada produksi! Generate dengan: openssl rand -hex 32
APP_KEY=

# Proteksi login dashboard opsional:
# Biarkan APP_PASSWORD kosong untuk akses tanpa login (mis. jaringan lokal/VPN)
APP_USERNAME=admin
APP_PASSWORD=

# Flag Secure cookie sesi: auto (default, mengikuti X-Forwarded-Proto), true, atau false
COOKIE_SECURE=auto

# Interval polling /v1/machines & /v1/ports dalam detik (minimum 5, default 15)
POLL_INTERVAL_SECONDS=15

# Interval tiered polling metrik live CPU/RAM/Disk tabel Fleet (detik, default 30, 0 = nonaktif)
METRICS_POLL_INTERVAL_SECONDS=30

# Batas error 401 berturut-turut sebelum akun otomatis dinonaktifkan (default 3, 0 = nonaktif)
ACCOUNT_MAX_AUTH_FAILURES=3

# Mode source-of-truth seeding akun dari ENV/File:
# - sync (default): ENV/File memperbarui akun source='seed' saat startup (akun UI tetap aman)
# - bootstrap: INSERT IF NOT EXISTS saja (DB selalu menang setelah seed pertama)
ACCOUNTS_SEED_MODE=sync

# Opsional: Bootstrap/Seeding multi-akun lewat JSON env atau file YAML/JSON
# INSTABOX_ACCOUNTS_JSON=[{"slug":"prod","name":"Prod Workspace","apiKey":"ibk_replace_me"}]
# INSTABOX_ACCOUNTS_FILE=/config/accounts.yaml
